{
  "name": "mer1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "scrape": "tsx scripts/scrape.ts",
    "ingest": "tsx scripts/ingest.ts",
    "ingest:budgets": "tsx scripts/ingest-budgets.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:registry": "tsx scripts/seed-registry.ts",
    "pipeline": "tsx scripts/pipeline.ts",
    "pipeline:all": "tsx scripts/pipeline.ts --status active",
    "d1:migrate:local": "wrangler d1 execute council-spend --local --file=scripts/d1/schema.sql",
    "d1:migrate:remote": "wrangler d1 execute council-spend --remote --file=scripts/d1/schema.sql",
    "d1:push": "tsx scripts/push-to-d1.ts",
    "cf:types": "wrangler types --include-runtime",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@opennextjs/cloudflare": "^1.20.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "better-sqlite3": "^12.8.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "next": "^15.5.20",
    "pdf-parse": "^1.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "^15.5.20",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wrangler": "^4.0.0"
  }
}
