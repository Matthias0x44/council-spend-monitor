{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "council-spend-monitor",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  // nodejs_compat: needed by @opennextjs/cloudflare and any Node-style libs.
  // global_fetch_strictly_public: required when our app fetches public URLs
  // (data.gov.uk, council pages) so workerd doesn't restrict cross-origin
  // fetches through the Worker.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Logged in the dashboard, useful for `wrangler tail`.
  "observability": {
    "enabled": true
  },
  // Historical Worker configuration for code review only. The hosted Worker
  // and D1 database were deleted on 25 September 2026. This placeholder must
  // be replaced with a new database ID for any future, separately budgeted
  // deployment; the portfolio demo never uses this binding.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "council-spend",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
