# Local development: leave both blocks unset — the app and scripts will
# fall back to file:./data/council-spend.db (better-sqlite3).

# ---------------------------------------------------------------------------
# Cloudflare D1 (production)
# ---------------------------------------------------------------------------
# Used by scripts/push-to-d1.ts and the GitHub Actions scrape workflow.
# Get account id from `wrangler whoami` or the dashboard URL bar.
# Create a token at https://dash.cloudflare.com/profile/api-tokens with
# the "Account → D1 → Edit" permission.
# Database id is printed by `npx wrangler d1 create council-spend`.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=

# ---------------------------------------------------------------------------
# Turso (legacy — being migrated away from)
# ---------------------------------------------------------------------------
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
